# Скопируйте в .env и заполните: cp .env.example .env
# .env содержит секреты и не попадает в Git. Пароли — случайные строки от 16 символов.

# ── Общее: единые правила времени во всех слоях ─────────────────────────────
# IANA-пояс по умолчанию. БД хранит UTC, API и агент отдают/принимают ISO 8601 с offset.
DEFAULT_TIMEZONE=Europe/Moscow
APP_ENV=production

# ── PostgreSQL (сервис postgres и роли из db/migrations) ───────────────────
POSTGRES_PORT=55432
POSTGRES_PASSWORD=
# Роль MCP-сервера: SELECT/INSERT events
APP_DB_PASSWORD=
# Роль HTTP API: SELECT/INSERT/DELETE events, UPDATE status, профили
API_DB_PASSWORD=

# ── Valkey / Redis (контекст диалога агента, TTL 15 минут) ─────────────────
VALKEY_PORT=6380
AGENT_HISTORY_LIMIT=40
AGENT_HISTORY_TTL_SECONDS=86400

# ── GigaChat — единственный LLM проекта ────────────────────────────────────
# Авторизационные данные из кабинета GigaChat API (base64 client_id:client_secret).
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — физлица; GIGACHAT_API_B2B / GIGACHAT_API_CORP — для ИП и юрлиц.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Для вызова инструментов рекомендуется GigaChat-2-Max; при слабых вызовах — GigaChat-2-Pro или GigaChat-3-Ultra.
GIGACHAT_MODEL=GigaChat-2-Max
# Российский сертификат Минцифры: путь к PEM-файлу, если системное хранилище его не содержит.
GIGACHAT_VERIFY_SSL_CERTS=true
GIGACHAT_CA_BUNDLE_FILE=
# Внутренний ключ между ботом и агентом (заголовок Authorization: Bearer).
AGENT_API_KEY=

# ── MAX ─────────────────────────────────────────────────────────────────────
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
# Точные имена CDN из attachments[].payload.url реальных голосовых сообщений MAX.
AUDIO_ALLOWED_HOSTS=
MAX_AUDIO_BYTES=20000000
# Ссылка на зарегистрированное в MAX Mini App (даёт платформа).
MINI_APP_LINK=
# Режим доставки бота: polling (разработка). Для webhook см. bot/README.md.
WEBHOOK_URL=
WEBHOOK_SECRET=
INTERNAL_API_KEY=

# ── ASR: выбор провайдера ───────────────────────────────────────────────────
# gigaam | yandex | elevenlabs | deepgram | whisper
ASR_PROVIDER=gigaam
# GigaAM-v3: сервис bot/asr/gigaam_server (профиль compose: gigaam)
GIGAAM_URL=http://asr:8001/v1/audio/transcriptions
GIGAAM_API_KEY=
# Hugging Face токен нужен только GigaAM для аудио длиннее 25 секунд
HF_TOKEN=
# Whisper: собственный HTTP-сервис (multipart file/model/language)
WHISPER_URL=
WHISPER_API_KEY=
WHISPER_MODEL=large-v3
# Yandex SpeechKit
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# ElevenLabs Speech-to-Text
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v1
# Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ── HTTP API и Mini App ─────────────────────────────────────────────────────
API_PORT=8002
# Origin Mini App для CORS (через запятую)
CORS_ORIGINS=http://localhost:8080
# Только для локальной разработки вне MAX: API доверяет заголовку X-Debug-User-Id
AUTH_DEV_MODE=false
MINIAPP_PORT=8080
# Адрес API, который увидит браузер пользователя (встраивается в сборку Mini App)
VITE_API_BASE=http://localhost:8002
VITE_BOT_LINK=
VITE_DEV_USER_ID=

# ── Порты на localhost ──────────────────────────────────────────────────────
MCP_PORT=8001
AGENT_PORT=8003
BOT_HEALTH_PORT=8081

# Separate least-privilege database roles
AGENT_DB_PASSWORD=
BOT_DB_PASSWORD=
MCP_AUTH_TOKEN=
PUBLIC_DOMAIN=localhost
AGENT_MAX_TOOL_ROUNDS=4
# ASR_PROVIDER=gigaam requires: docker compose --profile gigaam up --build -d
# AUDIO_ALLOWED_HOSTS: exact real MAX attachment CDN hostnames; rejected hosts are logged without URL/query.
