# ── Сервис ─────────────────────────────────────────────
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=*
DEFAULT_TIMEZONE=Europe/Moscow

# ── PostgreSQL ─────────────────────────────────────────
# Локальный запуск рядом с assistant-storage (порты опубликованы на localhost):
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=assistant_mvp
PGUSER=assistant_api
# Пароль роли assistant_api (в Docker-стеке это STACK_API_PASSWORD
# из data-platform/new_assistant_storage/.env.docker).
PGPASSWORD=change-me
PGCONNECT_TIMEOUT=5

# В общей Docker-сети команды:
# PGHOST=postgres
# PGPORT=5432

# ── Авторизация MAX ────────────────────────────────────
# Токен бота, к которому привязано Mini App.
# Нужен для проверки подписи initData. В Git не коммитить.
MAX_BOT_TOKEN=
MAX_INIT_DATA_TTL_SECONDS=3600

# Только для APP_ENV=development. В production запуск с этим флагом запрещён.
# При включении API доверяет заголовку X-Debug-User-Id (или DEV_USER_ID).
AUTH_DEV_MODE=false
DEV_USER_ID=dev:1

# ── Docker ─────────────────────────────────────────────
API_PORT=8002
