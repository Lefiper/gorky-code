# Copy to .env. Never upload .env or state/ to GitHub.
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru

# mock ONLY checks transport; it never creates tasks.
AGENT_MODE=mock
AGENT_URL=http://127.0.0.1:8001/chat
AGENT_API_KEY=

# MAX deep link to a registered mini app, supplied by the frontend developer.
# Example: https://max.ru/YOUR_BOT?startapp
MINI_APP_LINK=

# STT endpoint: multipart file/model/language -> JSON {"text":"..."}.
# Use a provider or a self-hosted Whisper-compatible transcription endpoint.
STT_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Exact audio CDN hostnames from your real MAX events, comma-separated.
# Audio is rejected until configured. Never put localhost/private services here.
AUDIO_ALLOWED_HOSTS=
MAX_AUDIO_BYTES=20000000

# Webhook server behind an HTTPS reverse proxy on port 443.
HOST=127.0.0.1
PORT=8080
WEBHOOK_URL=
WEBHOOK_SECRET=
# Allows the data service to register reminders via /internal/reminders.
INTERNAL_API_KEY=
# Optional trusted CA bundle, if required for the MAX certificate chain.
EXTRA_CA_FILE=
